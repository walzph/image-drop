{
  "name": "image-drop-app",
  "version": "1.0.0",
  "description": "A React-based web application for creating simple image drop websites",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "vite --host",
    "build:frontend": "vite build",
    "preview:frontend": "vite preview",
    "start:production": "NODE_ENV=production node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "vite"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.35",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1692.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^7.6.0",
    "nodemon": "^3.0.1",
    "vite": "^4.3.2"
  }
}
